<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the platform's square Android-5-era dialog background. The <inset>
     is load-bearing, not decoration: as a window background its insets are
     reported as padding, which is what keeps the dialog off the screen edges
     and its content off the rounded corners. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="16dp"
    android:insetRight="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="24dp" />
        <solid android:color="@color/clock_panel" />
        <stroke
            android:width="1dp"
            android:color="@color/clock_line_strong" />
    </shape>
</inset>
