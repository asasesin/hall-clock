<?xml version="1.0" encoding="utf-8"?>
<!-- The controller's plain .action: same pill, dark panel gradient, hairline
     border. Paired with action_primary it reproduces the web app's two-tier
     button hierarchy instead of the platform's primary/borderless one. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/clock_ripple_on_dark">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/clock_panel_2"
                android:endColor="@color/clock_panel_3" />
            <stroke
                android:width="1dp"
                android:color="@color/clock_line_strong" />
        </shape>
    </item>
</ripple>
